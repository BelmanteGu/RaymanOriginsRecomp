From f75880271f4cc87e0558fa7104bf904b47db4f86 Mon Sep 17 00:00:00 2001
From: BelmanteGu <gustavobelmanteribeiro@gmail.com>
Date: Fri, 25 Sep 2026 11:55:28 -0400
Subject: [PATCH] rexgpu-null plugin (command processing without GPU
 emulation); jthread/stop_token fallback for older libc++

---
 cmake/rexglue_install.cmake    |  1 +
 src/core/timer_queue.cpp       | 64 +++++++++++++++++++++++++++++---
 src/graphics/CMakeLists.txt    | 27 ++++++++++++++
 src/graphics/null/null_gpu.cpp | 67 ++++++++++++++++++++++++++++++++++
 4 files changed, 154 insertions(+), 5 deletions(-)
 create mode 100644 src/graphics/null/null_gpu.cpp

diff --git a/cmake/rexglue_install.cmake b/cmake/rexglue_install.cmake
index d9a64eb..63116c3 100644
--- a/cmake/rexglue_install.cmake
+++ b/cmake/rexglue_install.cmake
@@ -15,6 +15,7 @@ include(${CMAKE_CURRENT_LIST_DIR}/rexglue_helpers.cmake)
 set(REXGLUE_INSTALL_TARGETS
     rexruntime
     rexgpu-xenos
+    rexgpu-null
     disruptorplus renderdoc simde tomlplusplus
     aes128 mspack o1heap disasm xxhash
     libavcodec libavutil
diff --git a/src/core/timer_queue.cpp b/src/core/timer_queue.cpp
index 5cfea05..4dea64f 100644
--- a/src/core/timer_queue.cpp
+++ b/src/core/timer_queue.cpp
@@ -12,6 +12,60 @@
 #include <algorithm>
 #include <forward_list>
 
+#include <atomic>
+#include <memory>
+#include <thread>
+#include <version>
+
+// rex_jthread / rex_stop_token are missing from some libc++ builds (the
+// macOS 14 SDK, Android NDK r28 without -fexperimental-library). Minimal
+// stand-ins with the same use here.
+#if defined(__cpp_lib_jthread)
+using rex_jthread = std::jthread;
+using rex_stop_token = std::stop_token;
+#else
+class rex_stop_token {
+ public:
+  explicit rex_stop_token(const std::atomic<bool>* flag = nullptr) : flag_(flag) {}
+  bool stop_requested() const { return flag_ && flag_->load(std::memory_order_acquire); }
+
+ private:
+  const std::atomic<bool>* flag_;
+};
+class rex_jthread {
+ public:
+  using id = std::thread::id;
+  rex_jthread() = default;
+  template <class F>
+  explicit rex_jthread(F&& f) : stop_(std::make_unique<std::atomic<bool>>(false)) {
+    auto* flag = stop_.get();
+    thread_ = std::thread([flag, fn = std::forward<F>(f)]() mutable { fn(rex_stop_token(flag)); });
+  }
+  rex_jthread(rex_jthread&&) = default;
+  rex_jthread& operator=(rex_jthread&& other) {
+    Join();
+    thread_ = std::move(other.thread_);
+    stop_ = std::move(other.stop_);
+    return *this;
+  }
+  ~rex_jthread() { Join(); }
+  void request_stop() {
+    if (stop_) stop_->store(true, std::memory_order_release);
+  }
+  id get_id() const { return thread_.get_id(); }
+
+ private:
+  void Join() {
+    if (thread_.joinable()) {
+      request_stop();
+      thread_.join();
+    }
+  }
+  std::thread thread_;
+  std::unique_ptr<std::atomic<bool>> stop_;
+};
+#endif
+
 #include <disruptorplus/multi_threaded_claim_strategy.hpp>
 #include <disruptorplus/ring_buffer.hpp>
 #include <disruptorplus/sequence_barrier.hpp>
@@ -40,7 +94,7 @@ class TimerQueue {
         consumed_(wait_strategy_) {
     claim_strategy_.add_claim_barrier(consumed_);
     dispatch_thread_ =
-        std::jthread([this](std::stop_token stop_token) { TimerThreadMain(stop_token); });
+        rex_jthread([this](rex_stop_token stop_token) { TimerThreadMain(stop_token); });
   }
 
   ~TimerQueue() {
@@ -52,10 +106,10 @@ class TimerQueue {
     wait_item->Disarm();
     QueueTimer(std::move(wait_item));
 
-    // std::jthread auto-joins on destruction
+    // rex_jthread auto-joins on destruction
   }
 
-  void TimerThreadMain(std::stop_token stop_token) {
+  void TimerThreadMain(rex_stop_token stop_token) {
     dp::sequence_t next_sequence = 0;
     const auto comp = [](const std::shared_ptr<WaitItem>& left,
                          const std::shared_ptr<WaitItem>& right) {
@@ -136,7 +190,7 @@ class TimerQueue {
     return wait_item_weak;
   }
 
-  std::jthread::id dispatch_thread_id() const { return dispatch_thread_.get_id(); }
+  rex_jthread::id dispatch_thread_id() const { return dispatch_thread_.get_id(); }
 
  private:
   // This ring buffer will be used to introduce timers queued by the public API
@@ -149,7 +203,7 @@ class TimerQueue {
   // This is a _sorted_ (ascending due_) list of active timers managed by a
   // dedicated thread
   std::forward_list<std::shared_ptr<WaitItem>> wait_queue_;
-  std::jthread dispatch_thread_;
+  rex_jthread dispatch_thread_;
 };
 
 rex::thread::TimerQueue timer_queue_;
diff --git a/src/graphics/CMakeLists.txt b/src/graphics/CMakeLists.txt
index 0d8f8af..2bbe9ea 100644
--- a/src/graphics/CMakeLists.txt
+++ b/src/graphics/CMakeLists.txt
@@ -158,3 +158,30 @@ if(REXGLUE_USE_D3D12)
         dxguid
     )
 endif()
+
+# rexgpu-null: the same command processing without GPU emulation (no draws,
+# no copies), for games rendered by a native D3D-level renderer.
+set(REXGPU_NULL_SOURCES ${REXGPU_XENOS_SOURCES})
+list(REMOVE_ITEM REXGPU_NULL_SOURCES plugin_main.cpp)
+list(APPEND REXGPU_NULL_SOURCES null/null_gpu.cpp)
+add_library(rexgpu-null SHARED ${REXGPU_NULL_SOURCES})
+add_library(rex::gpu-null ALIAS rexgpu-null)
+set_target_properties(rexgpu-null PROPERTIES
+    EXPORT_NAME gpu-null
+    CXX_VISIBILITY_PRESET hidden
+    VISIBILITY_INLINES_HIDDEN ON
+)
+target_include_directories(rexgpu-null PRIVATE
+    ${REXGLUE_ROOT}/thirdparty/renderdoc
+    ${REXGLUE_ROOT}
+)
+target_compile_options(rexgpu-null PRIVATE -Wno-unused-variable)
+target_link_libraries(rexgpu-null PRIVATE rexruntime xxHash::xxhash)
+if(REXGLUE_USE_VULKAN)
+    target_link_libraries(rexgpu-null PRIVATE
+        Vulkan::Headers glslang::SPIRV GPUOpen::VulkanMemoryAllocator
+        glslang MachineIndependent GenericCodeGen OSDependent OGLCompiler)
+endif()
+if(REXGLUE_USE_D3D12)
+    target_link_libraries(rexgpu-null PRIVATE d3d12 dxgi dxguid)
+endif()
diff --git a/src/graphics/null/null_gpu.cpp b/src/graphics/null/null_gpu.cpp
new file mode 100644
index 0000000..aa963dd
--- /dev/null
+++ b/src/graphics/null/null_gpu.cpp
@@ -0,0 +1,67 @@
+/**
+ * @file        graphics/null/null_gpu.cpp
+ * @brief       rexgpu-null: command stream processing without GPU emulation.
+ *
+ * Keeps the guest's GPU protocol alive (ring buffer, fences, event writes,
+ * interrupts, vblank) but draws nothing: for games whose rendering is done by a
+ * native renderer hooked at the D3D level. Presentation stays available (the
+ * window exists), the guest output is simply never filled.
+ *
+ * @license     BSD 3-Clause License (same as ReXGlue)
+ */
+
+#include <memory>
+#include <string>
+#include <string_view>
+
+#include <rex/graphics/command_processor.h>
+#include <rex/graphics/graphics_system.h>
+#include <rex/logging.h>
+#include <rex/system/gpu_plugin.h>
+#include <rex/ui/vulkan/provider.h>
+
+namespace rex::graphics::null_gpu {
+
+class NullCommandProcessor : public CommandProcessor {
+ public:
+  NullCommandProcessor(GraphicsSystem* graphics_system, system::KernelState* kernel_state)
+      : CommandProcessor(graphics_system, kernel_state) {}
+
+  void IssueSwap(uint32_t, uint32_t, uint32_t) override {}
+
+ protected:
+  bool SetupContext() override { return true; }
+  void ShutdownContext() override {}
+  Shader* LoadShader(xenos::ShaderType, uint32_t, const uint32_t*, uint32_t) override { return nullptr; }
+  bool IssueDraw(xenos::PrimitiveType, uint32_t, IndexBufferInfo*, bool) override { return true; }
+  bool IssueCopy() override { return true; }
+};
+
+class NullGraphicsSystem : public GraphicsSystem {
+ public:
+  std::string name() const override { return "Null"; }
+
+ protected:
+  void CreateProvider(bool with_presentation) override {
+    provider_ = rex::ui::vulkan::VulkanProvider::Create(true, with_presentation);
+  }
+  std::unique_ptr<CommandProcessor> CreateCommandProcessor() override {
+    return std::make_unique<NullCommandProcessor>(this, kernel_state_);
+  }
+};
+
+}  // namespace rex::graphics::null_gpu
+
+extern "C" REX_GPU_PLUGIN_EXPORT uint32_t rex_gpu_abi_version(void) {
+  return rex::system::kGpuPluginAbiVersion;
+}
+
+extern "C" REX_GPU_PLUGIN_EXPORT rex::system::IGraphicsSystem* rex_gpu_create(
+    uint32_t abi_version, const rex::system::GpuCreateInfo* info) {
+  if (abi_version != rex::system::kGpuPluginAbiVersion || !info ||
+      info->struct_size < sizeof(rex::system::GpuCreateInfo)) {
+    REXLOG_ERROR("rexgpu-null: ABI or create info mismatch");
+    return nullptr;
+  }
+  return new rex::graphics::null_gpu::NullGraphicsSystem();
+}
