diff --git a/src/core/fiber_posix.cpp b/src/core/fiber_posix.cpp
index 4fe1ca6..cf74f07 100644
--- a/src/core/fiber_posix.cpp
+++ b/src/core/fiber_posix.cpp
@@ -22,11 +22,91 @@
 #include <rex/thread/fiber.h>
 
 #include <cassert>
+#include <cstdlib>
+
+#if REX_PLATFORM_ANDROID
+// Bionic has no ucontext switching. Save the AArch64 callee-saved registers of
+// `from` (x0) and load those of `to` (x1); `ret` then jumps to the loaded x30.
+// Layout matches Fiber::Context: x19-x30 at 0, sp at 96, d8-d15 at 104.
+// x18 is the platform register (shadow call stack) and is left untouched.
+extern "C" void rex_fiber_swap(void* from, const void* to);
+asm(R"(
+    .text
+    .p2align 2
+    .globl rex_fiber_swap
+    .type rex_fiber_swap, %function
+rex_fiber_swap:
+    stp x19, x20, [x0, #0]
+    stp x21, x22, [x0, #16]
+    stp x23, x24, [x0, #32]
+    stp x25, x26, [x0, #48]
+    stp x27, x28, [x0, #64]
+    stp x29, x30, [x0, #80]
+    mov x9, sp
+    str x9, [x0, #96]
+    stp d8, d9, [x0, #104]
+    stp d10, d11, [x0, #120]
+    stp d12, d13, [x0, #136]
+    stp d14, d15, [x0, #152]
+    ldp x19, x20, [x1, #0]
+    ldp x21, x22, [x1, #16]
+    ldp x23, x24, [x1, #32]
+    ldp x25, x26, [x1, #48]
+    ldp x27, x28, [x1, #64]
+    ldp x29, x30, [x1, #80]
+    ldr x9, [x1, #96]
+    mov sp, x9
+    ldp d8, d9, [x1, #104]
+    ldp d10, d11, [x1, #120]
+    ldp d12, d13, [x1, #136]
+    ldp d14, d15, [x1, #152]
+    ret
+    .size rex_fiber_swap, .-rex_fiber_swap
+)");
+#endif
 
 namespace rex::thread {
 
 thread_local Fiber* Fiber::tls_current_ = nullptr;
 
+#if REX_PLATFORM_ANDROID
+
+Fiber* Fiber::ConvertCurrentThread() {
+  // The thread's registers are saved into context_ on its first SwitchTo.
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+  auto top = reinterpret_cast<uintptr_t>(f->stack_.data() + f->stack_.size()) & ~uintptr_t(15);
+  f->context_.sp = top;
+  f->context_.x[10] = 0;  // x29: terminate frame-pointer chains
+  f->context_.x[11] = reinterpret_cast<uint64_t>(&Fiber::Trampoline);  // x30: first `ret` target
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+  // A fiber entry must switch away instead of returning (ucontext's
+  // uc_link = nullptr would end the thread here).
+  std::abort();
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_fiber_swap(&from->context_, &target->context_);
+}
+
+#else
+
 Fiber* Fiber::ConvertCurrentThread() {
   auto* f = new Fiber();
   if (getcontext(&f->context_) == -1) {
@@ -68,6 +148,8 @@ void Fiber::SwitchTo(Fiber* target) {
   swapcontext(&from->context_, &target->context_);
 }
 
+#endif  // REX_PLATFORM_ANDROID
+
 void Fiber::Destroy() {
   // Thread fibers are destroyed from the owning thread itself.
   if (is_thread_fiber_) {
